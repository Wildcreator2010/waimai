# ================================================================
# 取餐提醒 · 生产环境变量模板
# 复制为 deploy/.env 后填写；或执行 npm run env:init 自动生成密钥。
# 校验：npm run deploy:check
# ================================================================

# ---- 部署基础 ----
# 主域名（Caddy 自动申请证书）。没有域名时填 :80 仅内网可用。
DOMAIN=meal.example.com
TZ=Asia/Shanghai
# 品牌名：服务端邮件标题与 Web 页面标题。换品牌时两者一起改。
APP_NAME=取餐提醒
VITE_APP_NAME=取餐提醒
# auto：80/443 被占用时自动走「已有 nginx/宝塔」；也可显式写 caddy / external
DEPLOY_TOPOLOGY=auto

# ---- 远程再部署（npm run redeploy）----
# 留空则 npm run redeploy 只生成发布包，不上传；配好后可一键上传 + 远程升级
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/meal-reminder
# SSH 私钥路径；留空使用 ssh-agent / 默认密钥
DEPLOY_SSH_KEY=

# ---- 数据库 ----
POSTGRES_USER=meal
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=meal
DATABASE_URL=postgresql://meal:change-me-strong-password@db:5432/meal

# ---- 令牌 ----
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
EMAIL_TOKEN_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=60

# ---- MemberToken 加密密钥 ----
# openssl rand -base64 32
MEMBER_TOKEN_ENC_KEY=

# ---- 对外地址（邮件里的链接指向它）----
APP_BASE_URL=https://meal.example.com

# ---- 取餐柜接口 ----
# 默认值是本项目已适配的柜机供应商协议；换其他供应商时需同时调整
# server/src/locker/locker.client.ts 的接口路径与响应字段映射。
LOCKER_API_BASE=https://csmini.guangeiot.com
LOCKER_OPENMARK_PATH=/wechat/locker/openMark
LOCKER_TAKE_PATH=/wechat/locker/takeCode
LOCKER_OPENBOX_PATH=/wechat/locker/takeOpen
LOCKER_TIMEOUT_MS=10000
LOCKER_DEVICE_SN=2680
# 首次安装建议 true；录入 MemberToken 后改 false
LOCKER_MOCK=true
MOCK_ARRIVAL_AFTER=2

# ---- SMTP ----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 留空则自动用 APP_NAME 生成（品牌名 <no-reply@你的域名>）
SMTP_FROM=
# 没填 SMTP 时保持 true，验证码会打印在服务端日志里
MAIL_DRY_RUN=false

# ---- FCM（可选；留空则全部走 ntfy）----
# 有服务账号时填 /run/secrets/firebase-service-account.json，并把文件放到 deploy/secrets/
FIREBASE_SERVICE_ACCOUNT_PATH=
# 也可以直接内联完整 JSON（单行）；与 PATH 二选一即可
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- ntfy ----
# 服务端 publish 走容器内网；App 订阅走公网子域（ntfy 不支持子路径部署）
NTFY_SERVER_URL=http://ntfy:80
NTFY_PUBLIC_URL=https://ntfy.meal.example.com
NTFY_ACCESS_TOKEN=
NTFY_BASE_URL=https://ntfy.meal.example.com
# ntfy 独占的站点地址，需要 DNS 额外一条 A 记录
NTFY_DOMAIN=ntfy.meal.example.com

# ---- 阿里云短信 ----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_ARRIVAL=SMS_XXXXXXXX
ALIYUN_TEMPLATE_VERIFY=
ALIYUN_DRY_RUN=false

# ---- 浏览器 Web Push（VAPID）----
# 生成：npx web-push generate-vapid-keys，或 npm run env:init 自动生成
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com

# ---- 人机验证 ----
# builtin（内置算术题，默认）/ turnstile（Cloudflare）/ off（仅调试）
CAPTCHA_PROVIDER=builtin
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- 首次部署引导码（留空则自动生成并写入容器日志）----
BOOTSTRAP_SETUP_CODE=

# ---- 数据保留 ----
RETENTION_REMINDER_DAYS=30
RETENTION_AUDIT_DAYS=90

# ---- 镜像与构建 ----
# Dockerfile.online：联网多阶段构建（推荐，新服务器开箱即用）
# Dockerfile：离线构建，需先在构建机执行 bash scripts/prepare-image.sh
SERVER_DOCKERFILE=Dockerfile.online
SERVER_IMAGE=meal-reminder-server:prod
WEB_IMAGE=meal-reminder-web:prod
# 国内拉不到 Docker Hub 时换成加速地址（已实测可用）
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-alpine
NTFY_IMAGE=binwiederhier/ntfy:v2.11.0
CADDY_IMAGE=caddy:2-alpine
# 例：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine

# ---- 已有 nginx / 宝塔拓扑（DEPLOY_TOPOLOGY=external 时使用）----
# 容器只监听 127.0.0.1，下面的路径用于渲染配置与同步静态文件
NGINX_CONF_DIR=/etc/nginx/conf.d
STATIC_ROOT=/var/www/meal.example.com/dist
NTFY_STATIC_ROOT=/var/www/ntfy.meal.example.com
CERT_DIR=/etc/letsencrypt/live
API_PORT=8787
NTFY_PORT=8081

# ---- 备份（deploy/backup.sh 使用，可留空走默认）----
# BACKUP_DIR=./backups
# KEEP_DAYS=7
