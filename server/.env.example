# ---- 基础 ----
NODE_ENV=development
# 品牌名：用于邮件标题与告警；Web 端对应 VITE_APP_NAME
APP_NAME=取餐提醒
PORT=8787
# 对外访问地址，用于拼邮件里的验证/重置链接
APP_BASE_URL=http://127.0.0.1:5173
# 时区：影响「今日短信条数」的统计边界
TZ=Asia/Shanghai

# ---- 数据库 ----
# 本地开发默认用 deploy/docker-compose.dev.yml 起的 Postgres（端口 5433）
DATABASE_URL=postgresql://meal:meal@127.0.0.1:5433/meal_test

# ---- 令牌 ----
# 32 字节以上随机串：openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 一次性令牌（邮箱验证/重置密码）有效期
EMAIL_TOKEN_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=60

# ---- MemberToken 加密密钥（32 字节 base64）----
# 生成：openssl rand -base64 32
MEMBER_TOKEN_ENC_KEY=

# ---- 取餐柜接口（沿用旧版逆向结果）----
LOCKER_API_BASE=https://csmini.guangeiot.com
LOCKER_OPENMARK_PATH=/wechat/locker/openMark
LOCKER_TAKE_PATH=/wechat/locker/takeCode
LOCKER_OPENBOX_PATH=/wechat/locker/takeOpen
LOCKER_TIMEOUT_MS=10000
# 首次部署时的默认设备 SN（之后以管理台 SystemSetting 为准）
LOCKER_DEVICE_SN=2680
# 演示模式：不调真实接口，第 N 次查询起模拟入柜（默认第 2 次）
LOCKER_MOCK=false
MOCK_ARRIVAL_AFTER=2

# ---- SMTP（邮箱验证 / 找回密码 / ROOT 告警）----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人；留空则自动用 APP_NAME 生成（品牌名 <no-reply@example.com>）
SMTP_FROM=
# 开发模式：不发真邮件，把链接打到日志
MAIL_DRY_RUN=true

# ---- FCM（可选，缺失即自动跳过）----
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- ntfy ----
# 服务端 publish 用的地址（容器内网即可）
NTFY_SERVER_URL=http://127.0.0.1:8080
# App 要连的公网地址；ntfy 不支持子路径，必须是独立主机名
NTFY_PUBLIC_URL=
NTFY_BASE_URL=
NTFY_ACCESS_TOKEN=

# ---- 阿里云短信 ----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_ARRIVAL=SMS_XXXXXXXX
ALIYUN_TEMPLATE_VERIFY=
# 只写日志不真发
ALIYUN_DRY_RUN=true

# ---- 引导 ----
# 留空则首次启动自动生成一次性引导码（写日志与 data/bootstrap-code.txt）
BOOTSTRAP_SETUP_CODE=

# ---- 浏览器 Web Push（VAPID）----
# 生成：npx web-push generate-vapid-keys
# 留空则跳过浏览器推送（App 推送与短信不受影响）
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com

# ---- 数据保留（每日 03:00 清理）----
RETENTION_REMINDER_DAYS=30
RETENTION_AUDIT_DAYS=90
