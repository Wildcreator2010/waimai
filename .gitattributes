# 跨平台换行：仓库内脚本与部署配置统一 LF，避免在 Linux 上执行时报 \r 错误
* text=auto

*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tpl text eol=lf
*.conf text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
gradlew text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf
