# 复制为 android/local.properties 后按需填写（该文件不入库）
# Android SDK 路径（Windows 反斜杠需转义）
sdk.dir=C:\\Users\\<you>\\AppData\\Local\\Android\\Sdk

# 服务端地址，必须带结尾斜杠
API_BASE_URL=https://meal.example.com/

# ---- FCM（可选）----
# 优先方式：把 google-services.json 放到 android/app/，构建脚本会自动启用插件，下面四项无需填写。
# 备用方式：不想用插件时填这四项（值可从 google-services.json 里取，或用 scripts/check-fcm-config.mjs 打印）。
# 四项全空 = 未配置 = 推送走 ntfy，构建与运行都不受影响。
# FCM_PROJECT_ID=
# FCM_APP_ID=
# FCM_API_KEY=
# FCM_SENDER_ID=
