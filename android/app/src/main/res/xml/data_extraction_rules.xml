<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移规则，理由同 backup_rules.xml。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="meal_reminder_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="meal_reminder_secure.xml" />
    </device-transfer>
</data-extraction-rules>
